root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,slnx,ps1,cmd}]
end_of_line = crlf

[*.{java,gradle,properties,json,yml,yaml,md,html,mjs,cjs,py}]
end_of_line = lf

[*.cs]
indent_style = space
indent_size = 4

[*.{java,gradle,ps1,py}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,html,mjs,cjs}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

{
  "Urls": "http://0.0.0.0:8080",
  "Storage": {
    "DataPath": "..\\data"
  },
  "Security": {
    "SingleAdminSession": true
  },
  "Compatibility": {
    "AllowUnauthenticatedV15Agents": true
  },
  "RateLimits": {
    "AgentHubRequestsPerMinute": 120
  },
  "DeviceOfflineSeconds": 75,
  "CommandExecutionTimeoutSeconds": 20,
  "AndroidPollingCommandTimeoutSeconds": 75,
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
